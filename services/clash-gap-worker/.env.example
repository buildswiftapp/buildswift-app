PORT=8080
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
WORKER_SECRET=dev-secret-123
CLASH_GAP_BUCKET=document-attachments

CHUNK_DPI=300
CHUNK_JPEG_QUALITY=92
CHUNK_MAX_IMAGE_WIDTH=4800
CHUNK_RENDER_WORKERS=3
CHUNK_WORKERS=6
CHUNK_BATCH_SIZE=1
CHUNK_PAGE_BATCH_SIZE=40

DOCUMENT_AI_PROJECT_ID=your-gcp-project-id
DOCUMENT_AI_LOCATION=us
DOCUMENT_AI_PROCESSOR_ID=your-processor-id
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json

OCR_WORKERS=4
OCR_PAGE_WORKERS=6
OCR_DPI=400
OCR_MAX_IMAGE_WIDTH=6400
OCR_EMBEDDED_MIN_LEN=120
# Image OCR is on by default (best for CAD/drawing PDFs). Set OCR_FORCE_IMAGE=0 to prefer embedded text.
# OCR_FORCE_IMAGE=0
