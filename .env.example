NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional: bucket for account branding logos (defaults to document-attachments or REVIEW_SIGNATURES_BUCKET)
# BRANDING_LOGO_BUCKET=

OPENAI_API_KEY=
# Optional override; defaults to gpt-4o in AI route handlers
OPENAI_MODEL=gpt-4o

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Monthly subscription Price IDs from Stripe Dashboard (recommended for production).
# If unset, checkout uses dynamic price_data from lib/billing-plans.ts (dev-friendly).
STRIPE_PRICE_STARTER_MONTHLY=
STRIPE_PRICE_PROFESSIONAL_MONTHLY=
STRIPE_PRICE_BUSINESS_MONTHLY=

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Clash/Gap uploads: default 300 MB per file (see lib/upload-limits.ts).
# Next.js body buffer: next.config.mjs experimental.proxyClientMaxBodySize (320mb).
# OCR: pages per chunk (default 2), delay between chunks in ms (default 250).
# CLASH_GAP_OCR_CHUNK_SIZE=2
# CLASH_GAP_OCR_CHUNK_DELAY_MS=250
# OPENAI_OCR_MODEL=gpt-4o
# Chunk page limits for large files: per file (default 40) and overall per run (default 120).
# Each document is capped independently so a big plan set never starves the spec file.
# CLASH_GAP_MAX_PAGES_PER_FILE=40
# CLASH_GAP_MAX_PAGES_PER_RUN=120
# OCR image payload guards: max longest edge in px, JPEG quality, hard byte ceiling.
# CLASH_GAP_OCR_MAX_DIM=1024
# CLASH_GAP_OCR_JPEG_QUALITY=80
# CLASH_GAP_OCR_MAX_BYTES=5242880
