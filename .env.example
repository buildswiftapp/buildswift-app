NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional: bucket for account branding logos (defaults to document-attachments or REVIEW_SIGNATURES_BUCKET)
# BRANDING_LOGO_BUCKET=

OPENAI_API_KEY=
# Optional override; defaults to gpt-4o in AI route handlers
OPENAI_MODEL=gpt-4o

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Monthly subscription Price IDs from Stripe Dashboard (recommended for production).
# If unset, checkout uses dynamic price_data from lib/billing-plans.ts (dev-friendly).
STRIPE_PRICE_STARTER_MONTHLY=
STRIPE_PRICE_PROFESSIONAL_MONTHLY=
STRIPE_PRICE_BUSINESS_MONTHLY=

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Clash/Gap uploads: max bytes per file (default 500 MB, see lib/upload-limits.ts).
# Files stream straight from the browser to storage via a presigned URL. The
# Supabase project's global AND bucket "file size limit" must both be >= this,
# and the project spend cap must be disabled (the spend cap reduces the max
# upload size below whatever you type into the global limit).
# OPENAI_OCR_MODEL=gpt-4o
# OPENAI_OCR_TIMEOUT_MS=150000
# Hard ceiling on one page's OCR so a stuck page can't stall the whole stage (default 160000ms).
# CLASH_GAP_OCR_PAGE_TIMEOUT_MS=160000
# Chunk page limits for large files: per file (default 120) and overall per run (default 250).
# Each document is capped independently so a big plan set never starves the spec file.
# CLASH_GAP_MAX_PAGES_PER_FILE=120
# CLASH_GAP_MAX_PAGES_PER_RUN=250
# Chunk stored page-image size: longest edge in px (default 2200) and JPEG quality (default 82).
# Pages are stored as downscaled JPEGs (not scale-2 PNGs) — faster uploads/OCR, smaller storage.
# CLASH_GAP_CHUNK_MAX_DIM=2200
# CLASH_GAP_CHUNK_JPEG_QUALITY=82
# Concurrency: OCR vision calls in flight (default 10), page-image uploads in flight (default 6).
# CLASH_GAP_OCR_CONCURRENCY=10
# CLASH_GAP_UPLOAD_CONCURRENCY=6
# A chunk/OCR run idle (no progress) this long is treated as dead and may be resumed (default 150000ms).
# CLASH_GAP_STAGE_STALE_MS=150000
# OCR image payload guards: max longest edge in px, JPEG quality, hard byte ceiling.
# CLASH_GAP_OCR_MAX_DIM=1024
# CLASH_GAP_OCR_JPEG_QUALITY=80
# CLASH_GAP_OCR_MAX_BYTES=5242880
